# Example production environment variables
# Copy this to .env.production and fill in your actual values
# DO NOT commit .env.production to git!

# Supabase Configuration (Production)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_anon_key_here

# Application Configuration
NODE_ENV=production
VITE_APP_ENVIRONMENT=production
VITE_APP_NAME="FanArcs"
VITE_APP_VERSION=1.0.0

# Optional: Analytics & Monitoring
# VITE_ANALYTICS_ID=your_analytics_id
# VITE_SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Optional: Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PWA=false

# Optional: CDN Configuration
# VITE_CDN_URL=https://your-cdn-domain.com